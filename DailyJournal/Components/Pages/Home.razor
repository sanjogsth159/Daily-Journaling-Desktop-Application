@page "/home"

<h2 class="welcome-text">Welcome Back!</h2>

<div class="dashboard-grid">

    <!-- Stat Cards -->
    <div class="stat-card">
        🔥 <span>Total streak</span>
    </div>

    <div class="stat-card">
        🧾 <span>Total entries</span>
    </div>

    <div class="stat-card">
        🏅 <span>Longest streak</span>
    </div>

    <div class="stat-card">
        🕯️ <span>Average word/entry</span>
    </div>

    <!-- Today's Entry -->
    <div class="entry-card">
        <div class="entry-header">
            📅 <strong>Today's Entry</strong>
        </div>

        <div class="entry-meta">
            <span class="mood">😊 Happy</span>
            <span class="time">🕒 20 min ago</span>
        </div>

        <div class="entry-content">
            Today was a productive day. I made great progress on my projects
            and spent quality time with family. Feeling grateful for the
            opportunities ahead.
        </div>

        <div class="entry-footer">
            • 100 words
            <span class="view-link">View full Entry →</span>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="quick-actions">
        <h4>Quick Actions</h4>
        <div class="action-box"></div>
        <div class="action-box"></div>
        <div class="action-box"></div>
    </div>

</div>


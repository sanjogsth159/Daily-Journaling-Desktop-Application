@page "/"
@using DailyJournal.Components.Layout
@using DailyJournal.Model
@using DailyJournal.Service

@layout LoginLayout
@inject AuthService AuthService
@inject NavigationManager Nav

<EditForm Model="@user" OnValidSubmit="HandleLogin">
    <DataAnnotationsValidator />

    <div class="login-wrapper">
        <div class="login-card">

            <h3 class="login-title">Login</h3>

       
            <div class="form-group">
                <label class="label-text">Username</label>
                <InputText @bind-Value="user.UserName" class="form-control" placeholder="Enter username" />
            </div>

     
            <div class="form-group">
                <label class="label-text">Password</label>
                <InputText type="password" @bind-Value="user.Password" class="form-control" placeholder="Enter password" />
            </div>

       
            <button type="submit" class="btn btn-primary btn-login">
                Login
            </button>

        
            <p class="text-center mt-3">
                Don't have an account? <a href="/register">Register here</a>
            </p>

          
            @if (!string.IsNullOrEmpty(message))
            {
                <p class="text-center text-danger mt-2">@message</p>
            }
        </div>
    </div>
</EditForm>


@code {
    private UserModel user = new();
    private string? message;

    private async Task HandleLogin()
    {
        var (success, loggedUser, msg) = await AuthService.LoginAsync(user.UserName, user.Password);
        message = msg;

        Console.WriteLine($"Login attempt: {user.UserName} / {user.Password}");
        Console.WriteLine($"Login result: {success} - {msg}");

        if (success)
        {
            Nav.NavigateTo("/home"); // navigate to home
        }
    }
}

@page "/register"

@using DailyJournal.Model
@using DailyJournal.Components.Layout
@using DailyJournal.Service

@layout LoginLayout
@inject AuthService AuthService
@inject NavigationManager Nav

<EditForm Model="@user" OnValidSubmit="HandleValidSubmit">
	<DataAnnotationsValidator/>
	<ValidationSummary />

    <div class="container">
        <h3 class="text-center mb-4">Register</h3>

        <div class="mb-3">
            <label class="form-label">Username</label>
            <InputText @bind-Value="user.UserName"
                       class="form-control"
                       placeholder="Enter a username" />
        </div>

        <div class="mb-3">
            <label class="form-label">Password</label>
            <InputText type="password"
                       @bind-Value="user.Password"
                       class="form-control"
                       placeholder="Enter password" />
        </div>

        <div class="mb-3">
            <label class="form-label">Confirm Password</label>
            <InputText type="password"
                       @bind-Value="user.ConfirmPassword"
                       class="form-control"
                       placeholder="Confirm password" />
        </div>

        <button type="submit" class="btn btn-primary w-100 mt-3">
            Register
        </button>
        <p class="text-center mt-3">
            Already have an account? <a href="/">Login here</a>
        </p>

        @if (!string.IsNullOrEmpty(message))
        {
            <p class="text-center text-danger mt-2">@message</p>
        }
    </div>
</EditForm>

@code {
    private UserModel user = new();
    private string? message;

    private async Task HandleValidSubmit()
    {
        var (success, msg) = await AuthService.RegisterAsync(user);

        if (success)
        {
            message = null;
            Nav.NavigateTo("/"); // Go to login after successful registration
        }
        else
        {
            message = msg;
        }
    }
}

@page "/today-entry"
@page "/entry/{date}"
@using DailyJournal.Model
@using DailyJournal.Service
@using System.Globalization
@inject EntryService EntryService
@inject NavigationManager Nav
@inject IJSRuntime JS

<h3>Entry</h3>

@if (isLoading)
{
    <p>Loading…</p>
}
else
{
    <div class="mb-2 text-muted">
        @entry.Date.ToString("D") <span class="ms-3">Last saved: @entry.UpdatedAt.ToLocalTime().ToString("g")</span>
    </div>

    <div class="mb-3">
        <label class="form-label">Primary Mood (required)</label>
        <select class="form-select" @bind="entry.PrimaryMood">
            <option value="">-- Select primary mood --</option>
            @foreach (var cat in MoodCategories)
            {
                <optgroup label="@cat.Key">
                    @foreach (var m in cat.Value)
                    {
                        <option value="@m">@m</option>
                    }
                </optgroup>
            }
        </select>   
    </div>

    <div class="mb-3">
        <label class="form-label">Entry</label>
        <div class="editor-container">
            <div id="editor" style="min-height:300px;background:#fff;"></div>
        </div>
        <small class="text-muted d-block mt-1">~@EstimateWordCount() words</small>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-primary" @onclick="SaveAsync" disabled="@isSaving">
            @(isSaving ? "Saving..." : "Save")
        </button>

        @if (entry.EntryID != 0)
        {
            <button class="btn btn-danger" @onclick="DeleteAsync" disabled="@isSaving">
                @(isSaving ? "Working..." : "Delete")
            </button>
        }

        <button class="btn btn-secondary" @onclick="Cancel">Cancel</button>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <p class="mt-2 @(isError ? "text-danger" : "text-success")">@message</p>
    }
}

@code {
    [Parameter]
    public string? date { get; set; } // expects yyyy-MM-dd

    private EntryModel entry = new();
    private bool isLoading = true;
    private bool isSaving;
    private string? message;
    private bool isError;

    // When parameters change request that content be applied to Quill in OnAfterRenderAsync
    private bool needsSetContent;

    // Mood categories and values (used by the dropdown)
    private readonly Dictionary<string, string[]> MoodCategories = new()
    {
        { "Positive", new[] { "Happy", "Excited", "Relaxed", "Grateful", "Confident" } },
        { "Neutral",  new[] { "Calm", "Thoughtful", "Curious", "Nostalgic", "Bored" } },
        { "Negative", new[] { "Sad", "Angry", "Stressed", "Lonely", "Anxious" } }
    };

    // Load entry whenever route parameter changes. Use OnParametersSetAsync so navigation to /entry/{date} always reloads.
    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        message = null;
        isError = false;
        needsSetContent = false;

        try
        {
            if (!string.IsNullOrWhiteSpace(date))
            {
                // First try the strict yyyy-MM-dd format, then fall back to a flexible parse.
                if (DateTime.TryParseExact(date, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal, out var parsed)
                    || DateTime.TryParse(date, CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal | DateTimeStyles.AllowWhiteSpaces, out parsed))
                {
                    var existing = await EntryService.GetEntryByDateAsync(parsed.Date);
                    entry = existing ?? new EntryModel { Date = parsed.Date };
                    if (existing == null)
                    {
                        // show friendly note that a new entry will be created
                        message = $"No entry for {parsed:yyyy-MM-dd} — creating a new entry.";
                        isError = false;
                    }
                }
                else
                {
                    // Invalid date string — silently fall back to today's entry instead of showing an error.
                    entry = await EntryService.GetTodayEntryAsync();
                }
            }
            else
            {
                entry = await EntryService.GetTodayEntryAsync();
            }

            entry.PrimaryMood ??= string.Empty;

            // After loading data, request the editor content to be set on next render pass
            needsSetContent = true;
        }
        catch (Exception ex)
        {
            message = $"Failed to load entry: {ex.Message}";
            isError = true;
            entry = new EntryModel { Date = DateTime.UtcNow.Date };
        }
        finally
        {
            isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await EnsureQuillLoadedAndInitAsync();
            }
            catch (Exception ex)
            {
                message = $"Editor initialization failed: {ex.Message}";
                isError = true;
                Console.WriteLine($"Editor init error: {ex}");
            }
        }

        if (needsSetContent)
        {
            try
            {
                // Prefer calling quillEditor's setContent if it exists.
                var hasSetContent = false;
                try
                {
                    hasSetContent = await JS.InvokeAsync<bool>("eval", "!!(window.quillEditor && typeof quillEditor.setContent === 'function')");
                }
                catch
                {
                    hasSetContent = false;
                }

                if (hasSetContent)
                {
                    await JS.InvokeVoidAsync("quillEditor.setContent", entry.Content ?? string.Empty);
                }
                else
                {
                    // Fallback: directly write HTML into Quill editor container (works when quillIntrop.js doesn't expose setContent).
                    // Use JSON serialization so the HTML string is safely embedded in the eval.
                    var serialized = System.Text.Json.JsonSerializer.Serialize(entry.Content ?? string.Empty);
                    var script = $"(function(){{var h={serialized}; var ed=document.querySelector('#editor .ql-editor'); if(ed) ed.innerHTML = h; else if(document.getElementById('editor')) document.getElementById('editor').innerHTML = h; }})();";
                    await JS.InvokeVoidAsync("eval", script);
                }
            }
            catch
            {
                // ignore JS failures — editor will still function but content may be empty
            }

            needsSetContent = false;
        }
    }

    // Try a few times for the Quill library to be available before calling the simple init.
    private async Task EnsureQuillLoadedAndInitAsync()
    {
        const int attempts = 8;
        const int delayMs = 250;

        for (int i = 0; i < attempts; i++)
        {
            try
            {
                var hasQuill = await JS.InvokeAsync<bool>("eval", "typeof Quill !== 'undefined'");
                if (hasQuill)
                {
                    await JS.InvokeVoidAsync("quillEditor.init");
                    return;
                }
            }
            catch
            {
            }

            await Task.Delay(delayMs);
        }

        try { await JS.InvokeVoidAsync("quillEditor.init"); } catch { }
    }

    private async Task SaveAsync()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(entry.PrimaryMood))
            {
                message = "Please select a Primary Mood (required).";
                isError = true;
                return;
            }

            isSaving = true;

            string html = string.Empty;
            try
            {
                html = await JS.InvokeAsync<string>("quillEditor.getContent");
            }
            catch
            {
                try
                {
                    html = await JS.InvokeAsync<string>("eval", "document.querySelector('#editor .ql-editor') ? document.querySelector('#editor .ql-editor').innerHTML : ''");
                }
                catch
                {
                    html = entry.Content ?? string.Empty;
                }
            }

            entry.Content = html ?? string.Empty;

            var (success, msg) = await EntryService.SaveAsync(entry);
            message = msg;
            isError = !success;

            if (success)
            {
                // Refresh the entry from DB to pick up IDs/timestamps
                if (!string.IsNullOrWhiteSpace(date) && DateTime.TryParseExact(date, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal, out var pd))
                {
                    var fresh = await EntryService.GetEntryByDateAsync(pd.Date);
                    if (fresh != null) entry = fresh;
                }
                else
                {
                    entry = await EntryService.GetTodayEntryAsync();
                }

                // ensure editor reflects saved content
                try
                {
                    // Prefer setContent, otherwise fall back to direct DOM write (same approach as above).
                    var hasSetContent = false;
                    try
                    {
                        hasSetContent = await JS.InvokeAsync<bool>("eval", "!!(window.quillEditor && typeof quillEditor.setContent === 'function')");
                    }
                    catch { hasSetContent = false; }

                    if (hasSetContent)
                    {
                        await JS.InvokeVoidAsync("quillEditor.setContent", entry.Content ?? string.Empty);
                      }
                    else
                    {
                        var serialized = System.Text.Json.JsonSerializer.Serialize(entry.Content ?? string.Empty);
                        var script = $"(function(){{var h={serialized}; var ed=document.querySelector('#editor .ql-editor'); if(ed) ed.innerHTML = h; else if(document.getElementById('editor')) document.getElementById('editor').innerHTML = h; }})();";
                        await JS.InvokeVoidAsync("eval", script);
                    }
                }
                catch { }
            }
        }
        catch (Exception ex)
        {
            message = $"Save failed: {ex.Message}";
            isError = true;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (entry.EntryID == 0) return;

        if (!await JS.InvokeAsync<bool>("confirm", "Delete this entry permanently?"))
            return;

        try
        {
            isSaving = true;
            var (success, msg) = await EntryService.DeleteAsync(entry.EntryID);
            message = msg;
            isError = !success;

            if (success)
            {
                entry = new EntryModel { Date = DateTime.UtcNow.Date };
                try
                {
                    // same safe-set approach for cleared content
                    var hasSetContent = false;
                    try { hasSetContent = await JS.InvokeAsync<bool>("eval", "!!(window.quillEditor && typeof quillEditor.setContent === 'function')"); } catch { hasSetContent = false; }
                    if (hasSetContent) await JS.InvokeVoidAsync("quillEditor.setContent", entry.Content);
                    else await JS.InvokeVoidAsync("eval", "var ed=document.querySelector('#editor .ql-editor'); if(ed) ed.innerHTML=''; else if(document.getElementById('editor')) document.getElementById('editor').innerHTML='';");
                }
                catch { }
            }
        }
        catch (Exception ex)
        {
            message = $"Delete failed: {ex.Message}";
            isError = true;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel()
    {
        Nav.NavigateTo("/home");
    }

    private int EstimateWordCount()
    {
        if (string.IsNullOrWhiteSpace(entry.Content)) return 0;
        var plain = System.Text.RegularExpressions.Regex.Replace(entry.Content, "<.*?>", string.Empty);
        var words = plain.Split(new[] { ' ', '\t', '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
        return words.Length;
    }
}


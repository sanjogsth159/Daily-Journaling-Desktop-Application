@using DailyJournal.Model

<div class="entries-list">
    @if (PagedEntries.Any())
    {
        @foreach (var e in PagedEntries)
        {
            <div class="entry-row mb-2 p-2 border rounded">
                <div class="d-flex justify-content-between">
                    <div>
                        <strong>@(string.IsNullOrWhiteSpace(e.Title) ? GetSnippet(e.Content, 50) : e.Title)</strong>
                        <div class="text-muted small">@e.Date.ToLocalTime().ToString("g") • @(string.IsNullOrWhiteSpace(e.PrimaryMood) ? "—" : e.PrimaryMood)</div>
                    </div>
                    <div class="text-end">
                        <div class="small text-muted">@e.WordCount words</div>
                        <button class="btn btn-sm btn-link" @onclick="() => OnView.InvokeAsync(e.EntryID)">View</button>
                    </div>
                </div>
                <div class="mt-2">@GetSnippet(e.Content)</div>
            </div>
        }

        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="small text-muted">Showing @((currentPage - 1) * pageSize + 1)-@(((currentPage - 1) * pageSize) + PagedEntries.Count()) of @Filtered.Count()</div>
            <div>
                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="PrevPage" disabled="@(currentPage == 1)">Prev</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="NextPage" disabled="@(currentPage >= TotalPages)">Next</button>
            </div>
        </div>
    }
    else
    {
        <div class="text-muted">No entries found.</div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public List<EntryModel> Filtered { get; set; } = new();

    [Parameter]
    public int PageSize { get; set; } = 8;

    [Parameter]
    public EventCallback<int> OnView { get; set; }

    private int currentPage = 1;
    private int pageSize => Math.Max(1, PageSize);

    private IEnumerable<EntryModel> PagedEntries => Filtered
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize);

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(Filtered.Count / (double)pageSize));

    protected override void OnParametersSet()
    {
        // Reset page if filter set changes
        currentPage = 1;
    }

    private void PrevPage()
    {
        if (currentPage > 1) currentPage--;
    }

    private void NextPage()
    {
        if (currentPage < TotalPages) currentPage++;
    }

    private string GetSnippet(string html, int max = 100)
    {
        if (string.IsNullOrWhiteSpace(html)) return string.Empty;
        var plain = System.Text.RegularExpressions.Regex.Replace(html, "<.*?>", string.Empty).Trim();
        if (plain.Length <= max) return plain;
        return plain.Substring(0, max).TrimEnd() + "…";
    }
}